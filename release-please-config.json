{
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "adcp",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "include-component-in-tag": false,
      "exclude-paths": [
        "packages/adcp-reporting-storage"
      ]
    },
    "packages/adcp-reporting-storage": {
      "release-type": "python",
      "package-name": "adcp-reporting-storage",
      "component": "adcp-reporting-storage",
      "changelog-path": "CHANGELOG.md",
      "versioning": "prerelease",
      "prerelease-type": "beta",
      "prerelease": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "include-component-in-tag": true
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    }
  ],
  "separate-pull-requests": true
}
