# Patch: manifest.json signal_owned activate_signal removal
# Reason: signal_owned (owned signal agents) is a discovery-only
#   specialism — agents that own their own signals don't need a
#   marketplace activation step. Upstream's 3.1.0-rc.2 manifest includes
#   activate_signal in both ``activate_signal.specialisms`` AND
#   ``signal_owned.exercised_tools``, which would (a) require owned
#   signal agents to implement activate_signal and (b) make conformance
#   runners exercise marketplace activation for that specialism.
# Upstream status: SDK self-correction — the upstream rc.2 manifest
#   still reflects the older two-specialism activate_signal model.
# Drop when: upstream manifest removes signal_owned from
#   activate_signal.specialisms AND activate_signal from
#   signal_owned.exercised_tools.
--- a/schemas/cache/3.1.0-rc.2/manifest.json
+++ b/schemas/cache/3.1.0-rc.2/manifest.json
@@ -20,8 +20,7 @@
       "response_schema": "signals/activate-signal-response.json",
       "async_response_schemas": [],
       "specialisms": [
-        "signal_marketplace",
-        "signal_owned"
+        "signal_marketplace"
       ]
      },
      "build_creative": {
@@ -1414,7 +1414,6 @@
         "get_signals"
       ],
       "exercised_tools": [
-        "activate_signal",
         "get_adcp_capabilities",
         "get_signals"
       ]
