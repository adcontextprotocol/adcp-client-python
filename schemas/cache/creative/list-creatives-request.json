{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "Request parameters for querying creative assets from a creative library with filtering, sorting, and pagination. Implemented by any agent that hosts a creative library \u2014 creative agents (ad servers, creative platforms) and sales agents that manage creatives.",
  "examples": [
    {
      "data": {
        "filters": {
          "statuses": [
            "approved"
          ]
        }
      },
      "description": "List all approved creatives"
    },
    {
      "data": {
        "filters": {
          "concept_ids": [
            "concept_holiday_2026"
          ],
          "format_ids": [
            {
              "agent_url": "https://creative.example.com",
              "height": 250,
              "id": "display_static",
              "width": 300
            }
          ]
        },
        "include_variables": true
      },
      "description": "List creatives in a specific concept matching a format"
    },
    {
      "data": {
        "filters": {
          "has_variables": true,
          "statuses": [
            "approved"
          ]
        },
        "include_variables": true
      },
      "description": "Find DCO creatives for dynamic campaigns"
    },
    {
      "data": {
        "fields": [
          "creative_id",
          "name",
          "status"
        ],
        "include_assignments": false
      },
      "description": "Lightweight list with minimal fields"
    }
  ],
  "properties": {
    "context": {
      "$ref": "../core/context.json"
    },
    "ext": {
      "$ref": "../core/ext.json"
    },
    "fields": {
      "description": "Specific fields to include in response (omit for all fields). The 'concept' value returns both concept_id and concept_name.",
      "items": {
        "enum": [
          "creative_id",
          "name",
          "format_id",
          "status",
          "created_date",
          "updated_date",
          "tags",
          "assignments",
          "snapshot",
          "items",
          "variables",
          "concept"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "filters": {
      "$ref": "../core/creative-filters.json"
    },
    "include_assignments": {
      "default": true,
      "description": "Include package assignment information in response",
      "type": "boolean"
    },
    "include_items": {
      "default": false,
      "description": "Include items for multi-asset formats like carousels and native ads",
      "type": "boolean"
    },
    "include_snapshot": {
      "default": false,
      "description": "Include a lightweight delivery snapshot per creative (lifetime impressions and last-served date). For detailed performance analytics, use get_creative_delivery.",
      "type": "boolean"
    },
    "include_variables": {
      "default": false,
      "description": "Include dynamic content variable definitions (DCO slots) for each creative",
      "type": "boolean"
    },
    "pagination": {
      "$ref": "../core/pagination-request.json"
    },
    "sort": {
      "additionalProperties": true,
      "description": "Sorting parameters",
      "properties": {
        "direction": {
          "$ref": "../enums/sort-direction.json",
          "default": "desc",
          "description": "Sort direction"
        },
        "field": {
          "$ref": "../enums/creative-sort-field.json",
          "default": "created_date",
          "description": "Field to sort by"
        }
      },
      "type": "object"
    }
  },
  "title": "List Creatives Request",
  "type": "object"
}