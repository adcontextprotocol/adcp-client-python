{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "row_id": {
      "type": "string",
      "minLength": 1
    },
    "impressions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-adcp-control-total": {
        "value_type": "integer"
      }
    },
    "spend": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,37})\\.[0-9]{2}$",
      "x-adcp-control-total": {
        "value_type": "decimal",
        "scale": 2,
        "unit": "USD"
      }
    },
    "currency": {
      "const": "USD"
    },
    "details": {}
  },
  "required": [
    "row_id",
    "impressions",
    "spend",
    "currency"
  ],
  "additionalProperties": false
}
